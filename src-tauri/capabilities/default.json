{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pick folders with the native dialog and read/write files inside them. The fs scope starts empty; only folders picked in the dialog are added (without subfolders).",
  "windows": ["main"],
  "permissions": [
    "core:path:allow-join",
    "core:window:allow-set-title",
    "core:window:allow-set-always-on-top",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-ask",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-open",
    "fs:allow-read",
    "core:resources:allow-close",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "opener:allow-reveal-item-in-dir",
    "os:allow-platform"
  ]
}
