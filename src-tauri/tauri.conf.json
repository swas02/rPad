{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rPad",
  "version": "0.0.0-alpha",
  "identifier": "app.rpad.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": { "script": "npm run build:desktop -- --watch", "wait": false },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rPad",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "visible": false,
        "devtools": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "fileAssociations": [
      { "ext": ["txt", "text", "log", "md", "markdown", "csv", "ini", "cfg", "conf", "json", "yml", "yaml"], "name": "Text file", "description": "Plain text file", "mimeType": "text/plain", "role": "Editor" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installerHooks": "installer-hooks.nsh" } }
  }
}
