{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rPad",
  "version": "0.0.0-alpha",
  "identifier": "app.rpad.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "rPad",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "devtools": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-sync"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
